# =============================================================================
# MeetFlow — DEVELOPMENT environment template
# =============================================================================
# Intended for local work with `npm run infra:up` (Postgres + Redis in Docker).
# Copy to `.env.development` or `.env`. Never commit the copy.
# See .env.example for the full annotated reference of every variable.
# =============================================================================

# Host ports published by docker-compose. Raise these if 5432/6379 are already
# taken on your machine (a native PostgreSQL install will shadow the container),
# and keep DATABASE_URL/REDIS_URL below in sync.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

NODE_ENV=development
APP_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
LOG_LEVEL=debug
LOG_PRETTY=true

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://meetflow:meetflow@localhost:5432/meetflow_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetflow_dev
DB_USER=meetflow
DB_PASSWORD=meetflow
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=false

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=meetflow:dev

# Development-only placeholder secrets. Rotate before any shared deployment.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=meetflow
JWT_AUDIENCE=meetflow-api

# Both spellings of the loopback host: browsers treat http://localhost:5173 and
# http://127.0.0.1:5173 as different origins, and tooling disagrees about which
# to use (Playwright defaults to the IP, Vite prints the name). Allowing only
# one produces "This origin is not allowed to call the MeetFlow API" in exactly
# the situations that are hardest to debug.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOCKET_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Emails render into the log stream instead of being delivered.
EMAIL_PROVIDER=console
EMAIL_FROM="MeetFlow Dev <no-reply@meetflow.local>"

WORKER_CONCURRENCY=5
REMINDER_SWEEP_INTERVAL_SECONDS=60
# Convenient single-process development: run queue workers inside the API.
RUN_WORKER_IN_API=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_POINTS=1000
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_POINTS=120
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_POINTS=50
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

AVAILABILITY_MAX_RANGE_DAYS=62
AVAILABILITY_MAX_SLOTS=750
CACHE_BOOKING_LINK_TTL_SECONDS=30
IDEMPOTENCY_TTL_SECONDS=86400

SEED_DEFAULT_PASSWORD=MeetFlow!Demo123
SEED_ENABLED=true

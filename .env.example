# =============================================================================
# MeetFlow — Environment Template
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real `.env`. Only `*.example` files belong in git.
#
# Every variable is validated at startup by server/src/config/env.ts.
# The process refuses to boot on invalid/missing required configuration.
# =============================================================================

# --- Local infrastructure (docker-compose only) ------------------------------
# Host ports the dev containers publish. Change these if your machine already
# runs PostgreSQL or Redis locally, then point DATABASE_URL/REDIS_URL at them.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Runtime ----------------------------------------------------------------
# NODE_ENV drives framework behaviour (development | production | test).
NODE_ENV=development
# APP_ENV drives MeetFlow product behaviour. Exactly two app environments exist.
APP_ENV=development
# HTTP port for the API server.
PORT=4000
# Host interface the API binds to. 0.0.0.0 inside containers.
HOST=0.0.0.0
# Trust X-Forwarded-* headers (enable only behind a trusted proxy/load balancer).
TRUST_PROXY=false
# Structured log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Pretty-print logs (development only; production must stay false for JSON logs).
LOG_PRETTY=true

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL wins when set; otherwise the discrete DB_* values are used.
DATABASE_URL=postgres://meetflow:meetflow@localhost:5432/meetflow_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetflow_dev
DB_USER=meetflow
DB_PASSWORD=meetflow

# The test suite migrates this database from empty on every run, so it must
# never point at the one above — `--env test` deliberately honours only these
# two and never falls back to DATABASE_URL, because a shared fallback would
# silently migrate and truncate development data.
TEST_DATABASE_URL=postgres://meetflow:meetflow@localhost:5432/meetflow_test
TEST_DB_NAME=meetflow_test
# Require TLS for the database connection (true in managed production).
DB_SSL=false
# Sequelize connection pool bounds.
DB_POOL_MIN=2
DB_POOL_MAX=10
# Log every SQL statement (development debugging aid only).
DB_LOGGING=false

# --- Redis ------------------------------------------------------------------
# Cache, distributed rate limiting, locks, BullMQ queues, Socket.IO adapter.
# Redis is never the system of record.
REDIS_URL=redis://localhost:6379
# Prefix applied to every MeetFlow Redis key (keeps shared instances tidy).
REDIS_KEY_PREFIX=meetflow:dev

# --- JWT / sessions ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Access and refresh secrets must differ.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_0123456789abcdef
# Short-lived access token, long-lived rotating refresh token.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=meetflow
JWT_AUDIENCE=meetflow-api

# --- CORS / real-time -------------------------------------------------------
# Comma-separated list of exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Comma-separated list of origins allowed to open Socket.IO connections.
SOCKET_ORIGIN=http://localhost:5173

# --- URLs -------------------------------------------------------------------
# Public customer-facing app URL (used to build booking + management links).
PUBLIC_APP_URL=http://localhost:5173
# API base URL advertised in emails, webhooks and OpenAPI servers block.
API_BASE_URL=http://localhost:4000

# --- Email ------------------------------------------------------------------
# console  = render to structured logs (development default, sends nothing)
# smtp     = deliver through the SMTP_* settings below
EMAIL_PROVIDER=console
EMAIL_FROM="MeetFlow <no-reply@meetflow.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Background jobs --------------------------------------------------------
# Concurrency per worker process across MeetFlow queues.
WORKER_CONCURRENCY=5
# How often the reminder scheduler sweeps for due reminders (seconds).
REMINDER_SWEEP_INTERVAL_SECONDS=60
# Run queue workers inside the API process. Development convenience only —
# production must run the dedicated worker container instead.
RUN_WORKER_IN_API=false

# --- Rate limiting ----------------------------------------------------------
# Master switch. Keep true; disable only for targeted local load testing.
RATE_LIMIT_ENABLED=true
# Authenticated management API: requests per window per identity.
RATE_LIMIT_API_POINTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60
# Unauthenticated public booking API: requests per window per IP.
RATE_LIMIT_PUBLIC_POINTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# Credential endpoints (login / register / password reset) per IP.
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# --- Scheduling engine guardrails ------------------------------------------
# Hard ceiling on the date span a single availability query may request (days).
AVAILABILITY_MAX_RANGE_DAYS=62
# Hard ceiling on candidate slots returned by one availability query.
AVAILABILITY_MAX_SLOTS=750
# TTL for cached public booking-link configuration (seconds).
CACHE_BOOKING_LINK_TTL_SECONDS=120
# TTL for idempotency records covering public booking confirmation (seconds).
IDEMPOTENCY_TTL_SECONDS=86400

# --- Seeding ----------------------------------------------------------------
# Password assigned to every seeded demo account. Development only.
SEED_DEFAULT_PASSWORD=MeetFlow!Demo123
# Refuse to run seeders unless this is true (protects real environments).
SEED_ENABLED=true

{
  "name": "meetflow",
  "version": "1.0.0",
  "private": true,
  "description": "MeetFlow — Smart Appointment Scheduler. A scheduling operating system for service businesses and teams.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n server,worker,client -c blue,magenta,green \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:worker": "npm --workspace server run dev:worker",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml,css}\"",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm --workspace server run test",
    "test:client": "npm --workspace client run test",
    "test:unit": "npm --workspace server run test:unit",
    "test:integration": "npm --workspace server run test:integration",
    "test:e2e": "npm --workspace e2e run test",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:migrate:undo": "npm --workspace server run db:migrate:undo",
    "db:seed": "npm --workspace server run db:seed",
    "db:reset": "npm --workspace server run db:reset",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "secretscan": "node scripts/secret-scan.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}

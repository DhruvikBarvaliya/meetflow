# =============================================================================
# MeetFlow — PRODUCTION environment template
# =============================================================================
# Every value below is a PLACEHOLDER. Supply real values through your secret
# manager (AWS Secrets Manager, GCP Secret Manager, Vault, platform env vars).
# Do not bake secrets into container images and never commit a filled copy.
# See .env.example for the full annotated reference of every variable.
# =============================================================================

NODE_ENV=production
APP_ENV=production
PORT=4000
HOST=0.0.0.0
# Required when running behind a load balancer so client IPs (and therefore
# rate limiting and audit records) are accurate.
TRUST_PROXY=true
LOG_LEVEL=info
# Must stay false in production: logs are shipped as JSON.
LOG_PRETTY=false

# Managed PostgreSQL connection string.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/meetflow
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

# Managed Redis. Use rediss:// when the provider terminates TLS.
REDIS_URL=rediss://REPLACE_HOST:6379
REDIS_KEY_PREFIX=meetflow:prod

# REQUIRED: distinct, high-entropy secrets, minimum 32 characters.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_48_BYTE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_BYTE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=meetflow
JWT_AUDIENCE=meetflow-api

# Exact origins only — no wildcards in production.
CORS_ORIGINS=https://app.meetflow.example
SOCKET_ORIGIN=https://app.meetflow.example
PUBLIC_APP_URL=https://app.meetflow.example
API_BASE_URL=https://api.meetflow.example

EMAIL_PROVIDER=smtp
EMAIL_FROM="MeetFlow <no-reply@meetflow.example>"
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD

WORKER_CONCURRENCY=10
REMINDER_SWEEP_INTERVAL_SECONDS=60
# Production runs the dedicated worker container; never inside the API process.
RUN_WORKER_IN_API=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_POINTS=300
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_POINTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_POINTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

AVAILABILITY_MAX_RANGE_DAYS=62
AVAILABILITY_MAX_SLOTS=750
CACHE_BOOKING_LINK_TTL_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400

# Seeders are development-only and must stay disabled in production.
SEED_ENABLED=false

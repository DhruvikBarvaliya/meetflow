{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    /* `node16` rather than the older `node`/`CommonJS` pair, which TypeScript
       6.0 reports as deprecated (TS5107) and 7.0 removes outright.

       The emit is unchanged: server/package.json declares no `"type"`, so every
       .ts file under it is still a CommonJS module and still compiles to
       `require`. What does change is resolution — `node16` honours the
       `exports` and `imports` maps in a dependency's package.json, which is how
       the ecosystem has published types for years and which the old resolver
       ignored. That is a correctness improvement, not a compromise. */
    "module": "node16",
    "moduleResolution": "node16",

    /* Strictness — non-negotiable per CodingStandards.md */
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    /* Interop / emit */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": false,
    "pretty": true,

    /* Decorators are used by sequelize-typescript-free model definitions? No —
       models use the classic `Model.init` style, so decorators stay off. */
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false
  }
}

# MeetFlow web client environment.
# Copy to `.env.local` and adjust. Only VITE_-prefixed keys reach the browser,
# so never put a secret in this file.

# Base URL of the MeetFlow REST API, including the version segment.
# A relative path routes through the Vite dev proxy (see vite.config.ts), which
# keeps the app same-origin with the API: no CORS preflight on every request and
# the refresh cookie stays first-party. Point it at an absolute origin
# (e.g. https://api.meetflow.example/api/v1) when the API is deployed separately.
VITE_API_BASE_URL=/api/v1

# Socket.IO origin. Empty means "same origin", which the dev proxy forwards to
# the API. Set an absolute origin (e.g. https://api.meetflow.example) in
# environments where the API is not proxied.
VITE_SOCKET_URL=

# Optional: overrides the dev-server proxy target. Read by vite.config.ts only,
# never by the browser bundle.
# VITE_DEV_API_PROXY_TARGET=http://localhost:4000
